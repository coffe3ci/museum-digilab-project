#:import Window kivy.core.window.Window

# ============================================================
# OBJECT ITEM
# ============================================================

<ObjectItem@BoxLayout>:
    object_naam: ""
    object_id: 0
    afbeelding: ""
    nummer: ""

    orientation: "horizontal"
    size_hint_y: None
    height: "65dp"
    padding: ["12dp", "8dp"]
    spacing: "10dp"

    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]

    # NUMMER (zelfde rondje als op de objectenwand)
    Label:
        text: root.nummer
        font_size: "14sp"
        bold: True
        color: 1, 1, 1, 1
        size_hint: None, None
        size: "30dp", "30dp"
        pos_hint: {"center_y": 0.5}
        halign: "center"
        valign: "middle"
        text_size: self.size

        canvas.before:
            Color:
                rgba: 0, 0, 0, 0.55
            RoundedRectangle:
                pos: self.x - dp(1), self.y
                size: self.size
                radius: [15]

    # FOTO VOORBEELD
    Image:
        source: root.afbeelding
        size_hint: None, None
        size: "48dp", "48dp"
        pos_hint: {"center_y": 0.5}
        fit_mode: "cover"

        canvas.before:
            Color:
                rgba: 228/255, 222/255, 210/255, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(6)]


    # OBJECTNAAM
    Label:
        text: root.object_naam
        font_name: "Tekst"
        font_size: "14sp"
        bold: True
        color: 0.2, 0.2, 0.2, 1

        size_hint_x: 1
        halign: "left"
        valign: "middle"
        text_size: self.size
        shorten: True   # te lange titels worden afgekort met "..." zodat ze in het vak blijven
        max_lines: 1

    # BEWERKEN
    Button:
        text: "Bewerken"
        font_name: "Tekst"
        font_size: "11sp"
        bold: True
        color: 125/255, 67/255, 53/255, 1

        size_hint: None, None
        size: "75dp", "36dp"

        background_normal: ""
        background_down: ""
        background_color: 232/255, 224/255, 212/255, 1

        on_release:
            app.root.get_screen("admin_panel").object_bewerken(root.object_id)

    # VERWIJDEREN
    Button:
        text: "Verwijderen"
        font_name: "Tekst"
        font_size: "10sp"
        bold: True
        color: 125/255, 67/255, 53/255, 1

        size_hint: None, None
        size: "85dp", "36dp"

        background_normal: ""
        background_down: ""
        background_color: 232/255, 224/255, 212/255, 1

        on_release:
            app.root.get_screen("admin_panel").object_verwijderen(root.object_id, root.object_naam)


# ============================================================
# BOUWSTENEN VOOR DE FORMULIEREN (compact en overal dezelfde stijl)
# ============================================================

# Invoerveld
<FormulierVeld@TextInput>:
    font_name: "Tekst"
    font_size: "14sp"
    padding: ["10dp", "9dp"]
    size_hint_y: None
    height: "38dp"
    background_normal: ""
    background_active: ""
    background_color: 0, 0, 0, 0
    foreground_color: 0.1, 0.1, 0.1, 1
    hint_text_color: 0.6, 0.6, 0.6, 1
    cursor_color: 125/255, 67/255, 53/255, 1

    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [8]
        Color:
            rgba: (125/255, 67/255, 53/255, 1) if self.focus else (215/255, 208/255, 196/255, 1)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, 8)
            width: 1.1

# Klein grijs kopje boven een veld
<VeldLabel@Label>:
    font_name: "Klein"
    font_size: "12sp"
    bold: True
    color: 0.4, 0.4, 0.4, 1
    size_hint_y: None
    height: "18dp"
    halign: "left"
    valign: "middle"
    text_size: self.size

# Bruin kopje van een blok (bv. "Grootte")
<BlokKop@Label>:
    font_name: "Tekst"
    font_size: "14sp"
    bold: True
    color: 125/255, 67/255, 53/255, 1
    size_hint_y: None
    height: "20dp"
    halign: "left"
    valign: "middle"
    text_size: self.size

# Wit blok met afgeronde hoeken om velden te groeperen
<Kaart@BoxLayout>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    padding: "12dp"
    spacing: "6dp"
    canvas.before:
        Color:
            rgba: 1, 1, 1, 0.7
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12]

# Lichte knop (beige)
<ZachteKnop@Button>:
    font_name: "Tekst"
    font_size: "13sp"
    bold: True
    color: 125/255, 67/255, 53/255, 1
    size_hint_y: None
    height: "38dp"
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    canvas.before:
        Color:
            rgba: (220/255, 210/255, 198/255, 1) if self.state == "down" else (232/255, 224/255, 212/255, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [8]

# Hoofdknop (bruin), bv. "Opslaan"
<HoofdKnop@Button>:
    font_name: "Tekst"
    font_size: "14sp"
    bold: True
    color: 1, 1, 1, 1
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    canvas.before:
        Color:
            rgba: (100/255, 50/255, 40/255, 1) if self.state == "down" else (125/255, 67/255, 53/255, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10]

# Rode knop, bv. "Verwijderen"
<RodeKnop@Button>:
    font_name: "Tekst"
    font_size: "14sp"
    bold: True
    color: 1, 1, 1, 1
    background_normal: ""
    background_down: ""
    background_disabled_normal: ""
    background_color: 0, 0, 0, 0
    canvas.before:
        Color:
            rgba: (140/255, 35/255, 25/255, 1) if self.state == "down" else (180/255, 50/255, 40/255, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10]

# Rode foutmelding onderaan een formulier
<FoutLabel@Label>:
    text: ""
    font_name: "Klein"
    font_size: "12sp"
    bold: True
    color: 0.75, 0.20, 0.15, 1
    size_hint_y: None
    height: "18dp" if self.text else 0

# Keuzes in de dropdown "Positie"
<PositieOptie@SpinnerOption>:
    font_name: "Tekst"
    font_size: "13sp"
    color: 125/255, 67/255, 53/255, 1
    height: "34dp"
    background_normal: ""
    background_down: ""
    background_color: (225/255, 215/255, 202/255, 1) if self.state == "down" else (1, 1, 1, 1)


# ============================================================
# EXTRA AFBEELDINGEN: titel-knop en lege melding (in het objectformulier)
# ============================================================

# Eén regel in de lijst met extra afbeeldingen: alleen de titel, klik = bewerken
<ExtraTitelKnop@Button>:
    font_name: "Tekst"
    font_size: "13sp"
    bold: True
    color: 125/255, 67/255, 53/255, 1
    size_hint_y: None
    height: "30dp"
    halign: "left"
    valign: "middle"
    text_size: self.width - dp(20), None
    shorten: True   # te lange titels worden afgekort met "..."
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    canvas.before:
        Color:
            rgba: (220/255, 210/255, 198/255, 1) if self.state == "down" else (232/255, 224/255, 212/255, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(7)]

<ExtraLeegLabel@Label>:
    text: "Nog geen extra afbeeldingen"
    font_name: "Klein"
    font_size: "12sp"
    color: 0.55, 0.55, 0.55, 1
    size_hint_y: None
    height: "30dp"
    halign: "left"
    valign: "middle"
    text_size: self.size


# ============================================================
# EXTRA AFBEELDING (pop-up voor één extra afbeelding)
# Links een groot voorbeeld van de foto, rechts de instellingen in blokken.
# ============================================================

<ExtraAfbeeldingFormulier@Popup>:
    formulier: None   # het objectformulier waar deze afbeelding bij hoort
    index: -1         # -1 = nieuwe afbeelding, anders de plek in de lijst
    afbeelding: ""

    title: "Extra afbeelding toevoegen" if self.index < 0 else "Extra afbeelding bewerken"
    title_font: "Titel"
    title_size: "18sp"
    title_color: 0.15, 0.15, 0.15, 1
    separator_color: 125/255, 67/255, 53/255, 1
    background: ""
    background_color: 244/255, 239/255, 230/255, 1
    size_hint: None, None
    # Nooit groter dan het scherm
    width: min(Window.width * 0.9, dp(720))
    height: min(Window.height * 0.9, dp(480))
    auto_dismiss: False

    BoxLayout:
        orientation: "vertical"
        padding: "6dp"
        spacing: "10dp"

        BoxLayout:
            spacing: "14dp"

            # ---------- Links: de foto ----------
            BoxLayout:
                orientation: "vertical"
                size_hint_x: 0.45
                spacing: "8dp"

                # Voorbeeld van de foto op een beige vlak
                FloatLayout:
                    canvas.before:
                        Color:
                            rgba: 228/255, 222/255, 210/255, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [12]

                    Image:
                        source: root.afbeelding
                        fit_mode: "contain"
                        opacity: 1 if root.afbeelding else 0
                        size_hint: 0.92, 0.92
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}

                    Label:
                        text: "Nog geen afbeelding gekozen"
                        font_name: "Klein"
                        font_size: "13sp"
                        color: 0.5, 0.5, 0.5, 1
                        opacity: 0 if root.afbeelding else 1
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}

                ZachteKnop:
                    text: "Kies afbeelding" if not root.afbeelding else "Andere afbeelding kiezen"
                    on_release: app.root.get_screen("admin_panel").open_kiezer(root, "extra")

            # ---------- Rechts: de instellingen (scrollbaar als het niet past) ----------
            ScrollView:
                do_scroll_x: False
                bar_width: "4dp"

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "10dp"

                    # Titel + vinkje
                    Kaart:
                        BlokKop:
                            text: "Titel"

                        FormulierVeld:
                            id: titel
                            hint_text: "Naam van de afbeelding"
                            multiline: False

                        BoxLayout:
                            size_hint_y: None
                            height: "26dp"
                            spacing: "4dp"

                            CheckBox:
                                id: titel_zichtbaar
                                active: True   # standaard aan
                                size_hint_x: None
                                width: "26dp"
                                color: 125/255, 67/255, 53/255, 1

                            Button:
                                text: "Titel tonen onder de foto"
                                font_name: "Klein"
                                font_size: "12sp"
                                color: 0.35, 0.35, 0.35, 1
                                halign: "left"
                                valign: "middle"
                                text_size: self.size
                                background_normal: ""
                                background_down: ""
                                background_color: 0, 0, 0, 0
                                # Klikken op de tekst zet het vinkje ook om
                                on_release: titel_zichtbaar.active = not titel_zichtbaar.active

                    # Maximale grootte
                    Kaart:
                        BlokKop:
                            text: "Grootte"

                        # Simpele keuze, net als bij de positie
                        Spinner:
                            id: formaat
                            text: "Normaal"   # standaard
                            values: ["Klein", "Normaal", "Groot", "Origineel"]
                            option_cls: "PositieOptie"
                            size_hint_y: None
                            height: "38dp"
                            font_name: "Tekst"
                            font_size: "14sp"
                            bold: True
                            color: 125/255, 67/255, 53/255, 1
                            background_normal: ""
                            background_down: ""
                            background_color: 0, 0, 0, 0
                            canvas.before:
                                Color:
                                    rgba: 232/255, 224/255, 212/255, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [8]

                        Label:
                            text: "Klein 150  |  Normaal 250  |  Groot 350  |  Origineel = echte grootte"
                            font_name: "Klein"
                            font_size: "11sp"
                            color: 0.55, 0.55, 0.55, 1
                            size_hint_y: None
                            height: "16dp"
                            halign: "left"
                            valign: "middle"
                            text_size: self.size

                        VeldLabel:
                            text: "Eigen grootte in dp (optioneel, gaat voor de keuze hierboven)"

                        BoxLayout:
                            size_hint_y: None
                            height: "38dp"
                            spacing: "6dp"

                            FormulierVeld:
                                id: breedte
                                hint_text: "Breedte"
                                multiline: False
                                input_filter: "int"   # alleen cijfers

                            Label:
                                text: "x"
                                font_size: "14sp"
                                color: 0.5, 0.5, 0.5, 1
                                size_hint_x: None
                                width: "14dp"

                            FormulierVeld:
                                id: hoogte
                                hint_text: "Hoogte"
                                multiline: False
                                input_filter: "int"   # alleen cijfers

                    # Positie op de objectpagina
                    Kaart:
                        BlokKop:
                            text: "Positie op de pagina"

                        # Links/rechts = naast de beschrijving, midden = eronder
                        Spinner:
                            id: positie
                            text: "Midden"   # standaard
                            values: ["Links", "Midden", "Rechts"]
                            option_cls: "PositieOptie"
                            size_hint_y: None
                            height: "38dp"
                            font_name: "Tekst"
                            font_size: "14sp"
                            bold: True
                            color: 125/255, 67/255, 53/255, 1
                            background_normal: ""
                            background_down: ""
                            background_color: 0, 0, 0, 0
                            canvas.before:
                                Color:
                                    rgba: 232/255, 224/255, 212/255, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [8]

                        # Hoogte vanaf boven: alleen voor links en rechts (bij midden verborgen)
                        VeldLabel:
                            text: "Hoogte vanaf boven in dp (leeg = automatisch onder elkaar)"
                            height: "18dp" if positie.text != "Midden" else 0
                            opacity: 1 if positie.text != "Midden" else 0

                        FormulierVeld:
                            id: positie_hoogte
                            hint_text: "bv. 200"
                            multiline: False
                            input_filter: "int"   # alleen cijfers
                            height: "38dp" if positie.text != "Midden" else 0
                            opacity: 1 if positie.text != "Midden" else 0
                            disabled: positie.text == "Midden"

        FoutLabel:
            id: foutmelding

        # ---------- Knoppen onderaan ----------
        BoxLayout:
            size_hint_y: None
            height: "42dp"
            spacing: "10dp"

            # Alleen zichtbaar bij een bestaande afbeelding
            RodeKnop:
                text: "Verwijderen"
                size_hint_x: None
                width: "130dp"
                opacity: 1 if root.index >= 0 else 0
                disabled: root.index < 0
                on_release: app.root.get_screen("admin_panel").extra_verwijderen(root)

            Widget:   # lege ruimte, duwt de andere knoppen naar rechts

            ZachteKnop:
                text: "Annuleren"
                size_hint: None, None
                size: "120dp", "42dp"
                font_size: "14sp"
                on_release: root.dismiss()

            HoofdKnop:
                text: "Opslaan"
                size_hint_x: None
                width: "120dp"
                on_release: app.root.get_screen("admin_panel").extra_opslaan(root)


# ============================================================
# OBJECTFORMULIER (pop-up voor toevoegen en bewerken)
# ============================================================

<ObjectFormulier@Popup>:
    obj_id: 0    # 0 = nieuw object, anders het id van het object dat bewerkt wordt

    afbeelding: ""
    extra_afbeeldingen: []   # extra afbeeldingen (dicts met pad, titel, breedte, hoogte, ...)

    title: "Object toevoegen" if self.obj_id == 0 else "Object bewerken"
    title_font: "Titel"
    title_size: "18sp"
    title_color: 0.15, 0.15, 0.15, 1
    separator_color: 125/255, 67/255, 53/255, 1
    background: ""
    background_color: 244/255, 239/255, 230/255, 1
    size_hint: None, None
    # Nooit groter dan het scherm
    width: min(Window.width * 0.9, dp(560))
    height: min(Window.height * 0.9, dp(540))
    auto_dismiss: False

    BoxLayout:
        orientation: "vertical"
        padding: "6dp"
        spacing: "8dp"

        # Alle velden in een scrollgebied, zodat het formulier klein blijft
        ScrollView:
            do_scroll_x: False
            bar_width: "4dp"

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "10dp"

                # Nummer en titel naast elkaar
                Kaart:
                    BoxLayout:
                        size_hint_y: None
                        height: "56dp"
                        spacing: "10dp"

                        BoxLayout:
                            orientation: "vertical"
                            size_hint_x: None
                            width: "80dp"
                            spacing: "0dp"

                            VeldLabel:
                                text: "Nummer"

                            FormulierVeld:
                                id: nummer
                                multiline: False
                                input_filter: "int"   # alleen cijfers (plek op de objectenwand)

                        BoxLayout:
                            orientation: "vertical"
                            spacing: "0dp"

                            VeldLabel:
                                text: "Titel"

                            FormulierVeld:
                                id: titel
                                multiline: False

                    VeldLabel:
                        text: "Beschrijving"

                    FormulierVeld:
                        id: beschrijving
                        height: "90dp"

                # Hoofdafbeelding: klein voorbeeld + knoppen op één regel
                Kaart:
                    BlokKop:
                        text: "Afbeelding"

                    BoxLayout:
                        size_hint_y: None
                        height: "48dp"
                        spacing: "8dp"

                        Image:
                            source: root.afbeelding
                            size_hint_x: None
                            width: "48dp"
                            fit_mode: "contain"
                            opacity: 1 if root.afbeelding else 0   # onzichtbaar als er geen afbeelding is
                            canvas.before:
                                Color:
                                    rgba: 228/255, 222/255, 210/255, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [6]

                        ZachteKnop:
                            text: "Kies afbeelding"
                            pos_hint: {"center_y": 0.5}
                            on_release: app.root.get_screen("admin_panel").kies_afbeelding(root)

                        ZachteKnop:
                            text: "Verwijder"
                            size_hint_x: None
                            width: "90dp"
                            pos_hint: {"center_y": 0.5}
                            on_release: root.afbeelding = ""

                    # Grootte van de hoofdfoto (het schilderij bovenaan de objectpagina)
                    BoxLayout:
                        size_hint_y: None
                        height: "38dp"
                        spacing: "8dp"

                        VeldLabel:
                            text: "Grootte op de objectpagina"
                            height: "38dp"

                        Spinner:
                            id: hoofd_formaat
                            text: "Normaal"   # standaard
                            values: ["Klein", "Normaal", "Groot", "Origineel"]
                            option_cls: "PositieOptie"
                            size_hint_x: None
                            width: "140dp"
                            font_name: "Tekst"
                            font_size: "14sp"
                            bold: True
                            color: 125/255, 67/255, 53/255, 1
                            background_normal: ""
                            background_down: ""
                            background_color: 0, 0, 0, 0
                            canvas.before:
                                Color:
                                    rgba: 232/255, 224/255, 212/255, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [8]

                    Label:
                        text: "Klein 25%  |  Normaal 35%  |  Groot 50% van de schermhoogte  |  Origineel = echte grootte"
                        font_name: "Klein"
                        font_size: "11sp"
                        color: 0.55, 0.55, 0.55, 1
                        size_hint_y: None
                        height: "16dp"
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                        shorten: True

                # Extra afbeeldingen: alleen de titels; klik op een titel om hem te bewerken
                Kaart:
                    BoxLayout:
                        size_hint_y: None
                        height: "30dp"
                        spacing: "8dp"

                        BlokKop:
                            text: "Extra afbeeldingen"
                            height: "30dp"

                        ZachteKnop:
                            text: "+ Toevoegen"
                            size_hint_x: None
                            width: "110dp"
                            height: "30dp"
                            on_release: app.root.get_screen("admin_panel").open_extra_formulier(root, -1)

                    BoxLayout:
                        id: extra_lijst
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: "5dp"
                        # De titel-knoppen worden in admin_panel.py aangemaakt (toon_extra_afbeeldingen)

        FoutLabel:
            id: foutmelding

        # Knoppen onderaan (altijd zichtbaar, scrollen niet mee)
        BoxLayout:
            size_hint_y: None
            height: "42dp"
            spacing: "10dp"

            ZachteKnop:
                text: "Annuleren"
                height: "42dp"
                font_size: "14sp"
                on_release: root.dismiss()

            HoofdKnop:
                text: "Opslaan"
                on_release: app.root.get_screen("admin_panel").formulier_opslaan(root)


# ============================================================
# BEVESTIGEN VERWIJDEREN (pop-up)
# ============================================================

<BevestigVerwijderen@Popup>:
    obj_id: 0
    object_naam: ""

    title: "Object verwijderen"
    title_font: "Titel"
    title_size: "20sp"
    title_color: 0.15, 0.15, 0.15, 1
    separator_color: 125/255, 67/255, 53/255, 1
    background: ""
    background_color: 244/255, 239/255, 230/255, 1
    size_hint: 0.5, None
    height: "200dp"
    auto_dismiss: False

    BoxLayout:
        orientation: "vertical"
        padding: "10dp"
        spacing: "12dp"

        Label:
            text: 'Weet je zeker dat je "' + root.object_naam + '" wilt verwijderen?'
            font_name: "Tekst"
            font_size: "15sp"
            color: 0.2, 0.2, 0.2, 1
            halign: "center"
            valign: "middle"
            text_size: self.size

        BoxLayout:
            size_hint_y: None
            height: "48dp"
            spacing: "12dp"

            Button:
                text: "Annuleren"
                font_name: "Tekst"
                font_size: "15sp"
                bold: True
                color: 125/255, 67/255, 53/255, 1
                background_normal: ""
                background_down: ""
                background_color: 0, 0, 0, 0
                on_release: root.dismiss()
                canvas.before:
                    Color:
                        rgba: (220/255, 210/255, 198/255, 1) if self.state == "down" else (232/255, 224/255, 212/255, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12]

            Button:
                text: "Verwijderen"
                font_name: "Tekst"
                font_size: "15sp"
                bold: True
                color: 1, 1, 1, 1
                background_normal: ""
                background_down: ""
                background_color: 0, 0, 0, 0
                on_release: app.root.get_screen("admin_panel").verwijderen_bevestigd(root)
                canvas.before:
                    Color:
                        rgba: (140/255, 35/255, 25/255, 1) if self.state == "down" else (180/255, 50/255, 40/255, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12]


# ============================================================
# ADMIN PANEL SCREEN
# ============================================================

<AdminPanelScreen>:

    canvas.before:
        Color:
            rgba: 244/255, 239/255, 230/255, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: ["20dp", "20dp", "20dp", "20dp"]
        spacing: "15dp"

        # ====================================================
        # BOVENSTE BALK
        # ====================================================

        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "55dp"
            spacing: "12dp"

            Button:
                text: "<"
                font_name: "Tekst"
                font_size: "22sp"
                bold: True
                color: 125/255, 67/255, 53/255, 1

                size_hint: None, None
                size: "40dp", "40dp"

                background_normal: ""
                background_down: ""
                background_color: 232/255, 224/255, 212/255, 1

                on_release:
                    root.terug_naar_home()

            BoxLayout:
                orientation: "vertical"

                Label:
                    text: "STADSMUSEUM VEENENDAAL"
                    font_name: "Tekst"
                    font_size: "11sp"
                    bold: True
                    color: 125/255, 67/255, 53/255, 1
                    halign: "left"
                    valign: "bottom"
                    text_size: self.size

                Label:
                    text: "Beheer objecten"
                    font_name: "Titel"
                    font_size: "22sp"
                    color: 0.15, 0.15, 0.15, 1
                    halign: "left"
                    valign: "top"
                    text_size: self.size


        # ====================================================
        # OBJECT TOEVOEGEN
        # ====================================================

        Button:
            text: "+  Object toevoegen"
            font_name: "Tekst"
            font_size: "16sp"
            bold: True
            color: 1, 1, 1, 1

            size_hint_y: None
            height: "55dp"

            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0

            on_release:
                root.object_toevoegen()

            canvas.before:
                Color:
                    rgba: (100/255, 50/255, 40/255, 1) if self.state == "down" else (125/255, 67/255, 53/255, 1)

                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(10)]


        # ====================================================
        # AANTAL OBJECTEN
        # ====================================================

        Label:
            id: aantal_label
            text: "0 OBJECTEN"
            font_name: "Klein"
            font_size: "12sp"
            bold: True
            color: 0.5, 0.5, 0.5, 1

            size_hint_y: None
            height: "20dp"

            halign: "left"
            valign: "middle"
            text_size: self.size


        # ====================================================
        # OBJECTEN LIJST
        # ====================================================

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True

            BoxLayout:
                id: objecten_lijst

                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "10dp"

                # De ObjectItems worden in admin_panel.py aangemaakt (laad_objecten)


        # ====================================================
        # UITLOGGEN
        # ====================================================

        AnchorLayout:
            size_hint_y: None
            height: "50dp"

            anchor_x: "center"
            anchor_y: "center"

            Button:
                text: "Uitloggen"
                font_name: "Tekst"
                font_size: "15sp"
                bold: True
                color: 125/255, 67/255, 53/255, 1

                size_hint: None, None
                size: "140dp", "44dp"

                background_normal: ""
                background_down: ""
                background_color: 0, 0, 0, 0

                on_release:
                    root.uitloggen()

                canvas.before:
                    Color:
                        rgba: (220/255, 210/255, 198/255, 1) if self.state == "down" else (232/255, 224/255, 212/255, 1)

                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(8)]

# ============================================================
# AFBEELDING KIEZEN (pop-up)
# ============================================================

<AfbeeldingKiezer@Popup>:
    formulier: None   # het formulier dat de afbeelding moet krijgen
    doel: "hoofd"     # "hoofd" = hoofdafbeelding, "extra" = extra afbeeldingen (meerdere tegelijk)

    title: "Kies een afbeelding"
    title_font: "Titel"
    title_size: "20sp"
    size_hint: 0.8, 0.8
    auto_dismiss: False

    BoxLayout:
        orientation: "vertical"
        spacing: "10dp"

        FileChooserIconView:
            id: kiezer
            filters: ["*.png", "*.jpg", "*.jpeg"]   # alleen afbeeldingen tonen

        BoxLayout:
            size_hint_y: None
            height: "48dp"
            spacing: "12dp"

            Button:
                text: "Annuleren"
                on_release: root.dismiss()

            Button:
                text: "Kiezen"
                on_release: app.root.get_screen("admin_panel").afbeelding_gekozen(root)
