#:import Window kivy.core.window.Window
#:import get_color_from_hex kivy.utils.get_color_from_hex
#:import KLEUREN frontend.tekst_opmaak.KLEUREN
#:import MODI frontend.tekst_opmaak.MODI

# ============================================================
# OBJECT ITEM
# ============================================================

<ObjectItem@BoxLayout>:
    object_naam: ""
    object_id: 0
    afbeelding: ""
    nummer: ""

    orientation: "horizontal"
    size_hint_y: None
    height: "65dp"
    padding: ["12dp", "8dp"]
    spacing: "10dp"

    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]

    # NUMMER (zelfde rondje als op de objectenwand)
    Label:
        text: root.nummer
        font_size: "14sp"
        bold: True
        color: 1, 1, 1, 1
        size_hint: None, None
        size: "30dp", "30dp"
        pos_hint: {"center_y": 0.5}
        halign: "center"
        valign: "middle"
        text_size: self.size

        canvas.before:
            Color:
                rgba: 0, 0, 0, 0.55
            RoundedRectangle:
                pos: self.x - dp(1), self.y
                size: self.size
                radius: [15]

    # FOTO VOORBEELD
    Image:
        source: root.afbeelding
        size_hint: None, None
        size: "48dp", "48dp"
        pos_hint: {"center_y": 0.5}
        fit_mode: "cover"

        canvas.before:
            Color:
                rgba: 228/255, 222/255, 210/255, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(6)]


    # OBJECTNAAM
    Label:
        text: root.object_naam
        font_name: "Tekst"
        font_size: "14sp"
        bold: True
        color: 0.2, 0.2, 0.2, 1

        size_hint_x: 1
        halign: "left"
        valign: "middle"
        text_size: self.size
        shorten: True   # te lange titels worden afgekort met "..." zodat ze in het vak blijven
        max_lines: 1

    # BEWERKEN
    Button:
        text: "Bewerken"
        font_name: "Tekst"
        font_size: "11sp"
        bold: True
        color: 125/255, 67/255, 53/255, 1

        size_hint: None, None
        size: "75dp", "36dp"

        background_normal: ""
        background_down: ""
        background_color: 232/255, 224/255, 212/255, 1

        on_release:
            app.root.get_screen("admin_panel").object_bewerken(root.object_id)

    # VERWIJDEREN
    Button:
        text: "Verwijderen"
        font_name: "Tekst"
        font_size: "10sp"
        bold: True
        color: 125/255, 67/255, 53/255, 1

        size_hint: None, None
        size: "85dp", "36dp"

        background_normal: ""
        background_down: ""
        background_color: 232/255, 224/255, 212/255, 1

        on_release:
            app.root.get_screen("admin_panel").object_verwijderen(root.object_id, root.object_naam)


# ============================================================
# BOUWSTENEN VOOR DE FORMULIEREN (compact en overal dezelfde stijl)
# ============================================================

# Invoerveld
<FormulierVeld@TextInput>:
    font_name: "Tekst"
    font_size: "14sp"
    padding: ["10dp", "9dp"]
    size_hint_y: None
    height: "38dp"
    background_normal: ""
    background_active: ""
    background_color: 0, 0, 0, 0
    foreground_color: 0.1, 0.1, 0.1, 1
    hint_text_color: 0.6, 0.6, 0.6, 1
    cursor_color: 125/255, 67/255, 53/255, 1

    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [8]
        Color:
            rgba: (125/255, 67/255, 53/255, 1) if self.focus else (215/255, 208/255, 196/255, 1)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, 8)
            width: 1.1

# Invoerveld voor de beschrijving: ziet eruit als FormulierVeld, maar onthoudt ook de opmaak.
# De klasse staat in frontend/tekst_opmaak.py (OpmaakVeld).
<OpmaakVeld>:
    font_name: "Tekst"
    font_size: "14sp"
    padding: ["10dp", "9dp"]
    size_hint_y: None
    height: "130dp"
    background_normal: ""
    background_active: ""
    background_color: 0, 0, 0, 0
    foreground_color: 0.1, 0.1, 0.1, 1
    hint_text_color: 0.6, 0.6, 0.6, 1
    cursor_color: 125/255, 67/255, 53/255, 1
    selection_color: 125/255, 67/255, 53/255, 0.3

    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [8]
        Color:
            rgba: (125/255, 67/255, 53/255, 1) if self.focus else (215/255, 208/255, 196/255, 1)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, 8)
            width: 1.1

# Kleine vierkante knop in de opmaakbalk (B, I, U)
<OpmaakKnop@Button>:
    markup: True
    font_name: "Tekst"
    font_size: "15sp"
    color: 125/255, 67/255, 53/255, 1
    size_hint: None, None
    size: "34dp", "34dp"
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    canvas.before:
        Color:
            rgba: (220/255, 210/255, 198/255, 1) if self.state == "down" else (232/255, 224/255, 212/255, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [6]

# Rond kleurvakje in de opmaakbalk. kleur = "#rrggbb", of "" voor de standaard tekstkleur.
<KleurKnop@Button>:
    kleur: ""
    size_hint: None, None
    size: "26dp", "26dp"
    pos_hint: {"center_y": 0.5}
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    canvas.before:
        # Lichte rand, iets groter als je erop drukt
        Color:
            rgba: 215/255, 208/255, 196/255, 1
        Ellipse:
            pos: (self.x - dp(3), self.y - dp(3)) if self.state == "down" else (self.x - dp(1.5), self.y - dp(1.5))
            size: (self.width + dp(6), self.height + dp(6)) if self.state == "down" else (self.width + dp(3), self.height + dp(3))
        Color:
            # Standaard = de gewone tekstkleur van de objectpagina (donkergrijs)
            rgba: get_color_from_hex(self.kleur) if self.kleur else (0.2, 0.2, 0.2, 1)
        Ellipse:
            pos: self.pos
            size: self.size

# Klein grijs kopje boven een veld
<VeldLabel@Label>:
    font_name: "Klein"
    font_size: "12sp"
    bold: True
    color: 0.4, 0.4, 0.4, 1
    size_hint_y: None
    height: "18dp"
    halign: "left"
    valign: "middle"
    text_size: self.size

# Bruin kopje van een blok (bv. "Grootte")
<BlokKop@Label>:
    font_name: "Tekst"
    font_size: "14sp"
    bold: True
    color: 125/255, 67/255, 53/255, 1
    size_hint_y: None
    height: "20dp"
    halign: "left"
    valign: "middle"
    text_size: self.size

# Wit blok met afgeronde hoeken om velden te groeperen
<Kaart@BoxLayout>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    padding: "12dp"
    spacing: "6dp"
    canvas.before:
        Color:
            rgba: 1, 1, 1, 0.7
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12]

# Lichte knop (beige)
<ZachteKnop@Button>:
    font_name: "Tekst"
    font_size: "13sp"
    bold: True
    color: 125/255, 67/255, 53/255, 1
    size_hint_y: None
    height: "38dp"
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    canvas.before:
        Color:
            rgba: (220/255, 210/255, 198/255, 1) if self.state == "down" else (232/255, 224/255, 212/255, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [8]

# Hoofdknop (bruin), bv. "Opslaan"
<HoofdKnop@Button>:
    font_name: "Tekst"
    font_size: "14sp"
    bold: True
    color: 1, 1, 1, 1
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    canvas.before:
        Color:
            rgba: (100/255, 50/255, 40/255, 1) if self.state == "down" else (125/255, 67/255, 53/255, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10]

# Rode knop, bv. "Verwijderen"
<RodeKnop@Button>:
    font_name: "Tekst"
    font_size: "14sp"
    bold: True
    color: 1, 1, 1, 1
    background_normal: ""
    background_down: ""
    background_disabled_normal: ""
    background_color: 0, 0, 0, 0
    canvas.before:
        Color:
            rgba: (140/255, 35/255, 25/255, 1) if self.state == "down" else (180/255, 50/255, 40/255, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10]

# Rode foutmelding onderaan een formulier
<FoutLabel@Label>:
    text: ""
    font_name: "Klein"
    font_size: "12sp"
    bold: True
    color: 0.75, 0.20, 0.15, 1
    size_hint_y: None
    height: "18dp" if self.text else 0

# Keuzes in de dropdown "Positie"
<PositieOptie@SpinnerOption>:
    font_name: "Tekst"
    font_size: "13sp"
    color: 125/255, 67/255, 53/255, 1
    height: "34dp"
    background_normal: ""
    background_down: ""
    background_color: (225/255, 215/255, 202/255, 1) if self.state == "down" else (1, 1, 1, 1)


# ============================================================
# EXTRA AFBEELDINGEN: titel-knop en lege melding (in het objectformulier)
# ============================================================

# Eén regel in de lijst met extra afbeeldingen: alleen de titel, klik = bewerken
<ExtraTitelKnop@Button>:
    font_name: "Tekst"
    font_size: "13sp"
    bold: True
    color: 125/255, 67/255, 53/255, 1
    size_hint_y: None
    height: "30dp"
    halign: "left"
    valign: "middle"
    text_size: self.width - dp(20), None
    shorten: True   # te lange titels worden afgekort met "..."
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    canvas.before:
        Color:
            rgba: (220/255, 210/255, 198/255, 1) if self.state == "down" else (232/255, 224/255, 212/255, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(7)]

<ExtraLeegLabel@Label>:
    text: "Nog geen extra afbeeldingen"
    font_name: "Klein"
    font_size: "12sp"
    color: 0.55, 0.55, 0.55, 1
    size_hint_y: None
    height: "30dp"
    halign: "left"
    valign: "middle"
    text_size: self.size


# ============================================================
# EXTRA AFBEELDING (pop-up voor één extra afbeelding)
# Links een groot voorbeeld van de foto, rechts de instellingen in blokken.
# ============================================================

<ExtraAfbeeldingFormulier@Popup>:
    formulier: None   # het objectformulier waar deze afbeelding bij hoort
    index: -1         # -1 = nieuwe afbeelding, anders de plek in de lijst
    afbeelding: ""

    title: "Extra afbeelding toevoegen" if self.index < 0 else "Extra afbeelding bewerken"
    title_font: "Titel"
    title_size: "18sp"
    title_color: 0.15, 0.15, 0.15, 1
    separator_color: 125/255, 67/255, 53/255, 1
    background: ""
    background_color: 244/255, 239/255, 230/255, 1
    size_hint: None, None
    # Nooit groter dan het scherm
    width: min(Window.width * 0.9, dp(720))
    height: min(Window.height * 0.9, dp(480))
    auto_dismiss: False

    BoxLayout:
        orientation: "vertical"
        padding: "6dp"
        spacing: "10dp"

        BoxLayout:
            spacing: "14dp"

            # ---------- Links: de foto ----------
            BoxLayout:
                orientation: "vertical"
                size_hint_x: 0.45
                spacing: "8dp"

                # Voorbeeld van de foto op een beige vlak
                FloatLayout:
                    canvas.before:
                        Color:
                            rgba: 228/255, 222/255, 210/255, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [12]

                    Image:
                        source: root.afbeelding
                        fit_mode: "contain"
                        opacity: 1 if root.afbeelding else 0
                        size_hint: 0.92, 0.92
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}

                    Label:
                        text: "Nog geen afbeelding gekozen"
                        font_name: "Klein"
                        font_size: "13sp"
                        color: 0.5, 0.5, 0.5, 1
                        opacity: 0 if root.afbeelding else 1
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}

                ZachteKnop:
                    text: "Kies afbeelding" if not root.afbeelding else "Andere afbeelding kiezen"
                    on_release: app.root.get_screen("admin_panel").open_kiezer(root, "extra")

            # ---------- Rechts: de instellingen (scrollbaar als het niet past) ----------
            ScrollView:
                do_scroll_x: False
                bar_width: "4dp"

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "10dp"

                    # Titel + vinkje
                    Kaart:
                        BlokKop:
                            text: "Titel"

                        FormulierVeld:
                            id: titel
                            hint_text: "Naam van de afbeelding"
                            multiline: False

                        BoxLayout:
                            size_hint_y: None
                            height: "26dp"
                            spacing: "4dp"

                            CheckBox:
                                id: titel_zichtbaar
                                active: True   # standaard aan
                                size_hint_x: None
                                width: "26dp"
                                color: 125/255, 67/255, 53/255, 1

                            Button:
                                text: "Titel tonen onder de foto"
                                font_name: "Klein"
                                font_size: "12sp"
                                color: 0.35, 0.35, 0.35, 1
                                halign: "left"
                                valign: "middle"
                                text_size: self.size
                                background_normal: ""
                                background_down: ""
                                background_color: 0, 0, 0, 0
                                # Klikken op de tekst zet het vinkje ook om
                                on_release: titel_zichtbaar.active = not titel_zichtbaar.active

                    # Maximale grootte
                    Kaart:
                        BlokKop:
                            text: "Grootte"

                        # Simpele keuze, net als bij de positie
                        Spinner:
                            id: formaat
                            text: "Normaal"   # standaard
                            values: ["Klein", "Normaal", "Groot", "Origineel"]
                            option_cls: "PositieOptie"
                            size_hint_y: None
                            height: "38dp"
                            font_name: "Tekst"
                            font_size: "14sp"
                            bold: True
                            color: 125/255, 67/255, 53/255, 1
                            background_normal: ""
                            background_down: ""
                            background_color: 0, 0, 0, 0
                            canvas.before:
                                Color:
                                    rgba: 232/255, 224/255, 212/255, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [8]

                        Label:
                            text: "Klein 150  |  Normaal 250  |  Groot 350  |  Origineel = echte grootte"
                            font_name: "Klein"
                            font_size: "11sp"
                            color: 0.55, 0.55, 0.55, 1
                            size_hint_y: None
                            height: "16dp"
                            halign: "left"
                            valign: "middle"
                            text_size: self.size

                        VeldLabel:
                            text: "Eigen grootte in dp (optioneel, gaat voor de keuze hierboven)"

                        BoxLayout:
                            size_hint_y: None
                            height: "38dp"
                            spacing: "6dp"

                            FormulierVeld:
                                id: breedte
                                hint_text: "Breedte"
                                multiline: False
                                input_filter: "int"   # alleen cijfers

                            Label:
                                text: "x"
                                font_size: "14sp"
                                color: 0.5, 0.5, 0.5, 1
                                size_hint_x: None
                                width: "14dp"

                            FormulierVeld:
                                id: hoogte
                                hint_text: "Hoogte"
                                multiline: False
                                input_filter: "int"   # alleen cijfers

                    # Positie op de objectpagina
                    Kaart:
                        BlokKop:
                            text: "Positie op de pagina"

                        # Links/rechts = naast de beschrijving, midden = eronder
                        Spinner:
                            id: positie
                            text: "Midden"   # standaard
                            values: ["Links", "Midden", "Rechts"]
                            option_cls: "PositieOptie"
                            size_hint_y: None
                            height: "38dp"
                            font_name: "Tekst"
                            font_size: "14sp"
                            bold: True
                            color: 125/255, 67/255, 53/255, 1
                            background_normal: ""
                            background_down: ""
                            background_color: 0, 0, 0, 0
                            canvas.before:
                                Color:
                                    rgba: 232/255, 224/255, 212/255, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [8]

                        # Hoogte vanaf boven: alleen voor links en rechts (bij midden verborgen)
                        VeldLabel:
                            text: "Hoogte vanaf boven in dp (leeg = automatisch onder elkaar)"
                            height: "18dp" if positie.text != "Midden" else 0
                            opacity: 1 if positie.text != "Midden" else 0

                        FormulierVeld:
                            id: positie_hoogte
                            hint_text: "bv. 200"
                            multiline: False
                            input_filter: "int"   # alleen cijfers
                            height: "38dp" if positie.text != "Midden" else 0
                            opacity: 1 if positie.text != "Midden" else 0
                            disabled: positie.text == "Midden"

        FoutLabel:
            id: foutmelding

        # ---------- Knoppen onderaan ----------
        BoxLayout:
            size_hint_y: None
            height: "42dp"
            spacing: "10dp"

            # Alleen zichtbaar bij een bestaande afbeelding
            RodeKnop:
                text: "Verwijderen"
                size_hint_x: None
                width: "130dp"
                opacity: 1 if root.index >= 0 else 0
                disabled: root.index < 0
                on_release: app.root.get_screen("admin_panel").extra_verwijderen(root)

            Widget:   # lege ruimte, duwt de andere knoppen naar rechts

            ZachteKnop:
                text: "Annuleren"
                size_hint: None, None
                size: "120dp", "42dp"
                font_size: "14sp"
                on_release: root.dismiss()

            HoofdKnop:
                text: "Opslaan"
                size_hint_x: None
                width: "120dp"
                on_release: app.root.get_screen("admin_panel").extra_opslaan(root)


# ============================================================
# OBJECTFORMULIER (pop-up voor toevoegen en bewerken)
# ============================================================

<ObjectFormulier@Popup>:
    obj_id: 0    # 0 = nieuw object, anders het id van het object dat bewerkt wordt

    afbeelding: ""
    extra_afbeeldingen: []   # extra afbeeldingen (dicts met pad, titel, breedte, hoogte, ...)
    opmaak_doel: "beschrijving"   # op welk veld de opmaakknoppen werken: "titel" of "beschrijving"

    title: "Object toevoegen" if self.obj_id == 0 else "Object bewerken"
    title_font: "Titel"
    title_size: "18sp"
    title_color: 0.15, 0.15, 0.15, 1
    separator_color: 125/255, 67/255, 53/255, 1
    background: ""
    background_color: 244/255, 239/255, 230/255, 1
    size_hint: None, None
    # Nooit groter dan het scherm
    width: min(Window.width * 0.9, dp(560))
    height: min(Window.height * 0.9, dp(540))
    auto_dismiss: False

    BoxLayout:
        orientation: "vertical"
        padding: "6dp"
        spacing: "8dp"

        # Alle velden in een scrollgebied, zodat het formulier klein blijft
        ScrollView:
            do_scroll_x: False
            bar_width: "4dp"

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "10dp"

                # Opmaak, nummer, titel en beschrijving
                Kaart:
                    # ---------- Tekst opmaken (werkt op titel en beschrijving) ----------
                    BoxLayout:
                        size_hint_y: None
                        height: "22dp"
                        spacing: "6dp"

                        BlokKop:
                            text: "Tekst opmaken"
                            size_hint_x: None
                            width: self.texture_size[0]
                            text_size: None, None
                            height: "22dp"

                        # Laat zien op welk veld de knoppen werken (het veld waarin je het laatst klikte)
                        VeldLabel:
                            text: "voor: " + ("Titel" if root.opmaak_doel == "titel" else "Beschrijving")
                            height: "22dp"
                            shorten: True

                    # De knoppen staan in groepjes. Past een groepje niet meer op de regel
                    # (smal scherm), dan gaat het naar de volgende regel.
                    StackLayout:
                        orientation: "lr-tb"
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: "8dp"

                        # 1. Waarop: geselecteerde woorden, zin, alinea of de hele tekst
                        BoxLayout:
                            size_hint: None, None
                            width: min(dp(258), self.parent.width)
                            height: "34dp"
                            spacing: "8dp"

                            VeldLabel:
                                text: "Toepassen op"
                                size_hint_x: None
                                width: "90dp"
                                height: "34dp"

                            Spinner:
                                id: opmaak_modus
                                text: MODI[0]
                                values: MODI
                                option_cls: "PositieOptie"
                                font_name: "Tekst"
                                font_size: "13sp"
                                bold: True
                                color: 125/255, 67/255, 53/255, 1
                                shorten: True
                                text_size: self.width - dp(10), None
                                halign: "center"
                                background_normal: ""
                                background_down: ""
                                background_color: 0, 0, 0, 0
                                canvas.before:
                                    Color:
                                        rgba: 232/255, 224/255, 212/255, 1
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [8]

                        # 2. Vet, schuin, onderstreept
                        BoxLayout:
                            size_hint: None, None
                            width: self.minimum_width
                            height: "34dp"
                            spacing: "6dp"

                            OpmaakKnop:
                                text: "[b]B[/b]"
                                on_release: app.root.get_screen("admin_panel").tekst_opmaken(root, "b")
                            OpmaakKnop:
                                text: "[i]I[/i]"
                                on_release: app.root.get_screen("admin_panel").tekst_opmaken(root, "i")
                            OpmaakKnop:
                                text: "[u]U[/u]"
                                on_release: app.root.get_screen("admin_panel").tekst_opmaken(root, "u")

                        # 3. Eén rondje per kleur (lijst KLEUREN in frontend/tekst_opmaak.py)
                        BoxLayout:
                            size_hint: None, None
                            width: self.minimum_width
                            height: "34dp"
                            spacing: "8dp"
                            padding: ["4dp", 0]

                            KleurKnop:
                                kleur: KLEUREN[0][1] or ""
                                on_release: app.root.get_screen("admin_panel").tekst_opmaken(root, "kleur", None)
                            KleurKnop:
                                kleur: KLEUREN[1][1]
                                on_release: app.root.get_screen("admin_panel").tekst_opmaken(root, "kleur", self.kleur)
                            KleurKnop:
                                kleur: KLEUREN[2][1]
                                on_release: app.root.get_screen("admin_panel").tekst_opmaken(root, "kleur", self.kleur)
                            KleurKnop:
                                kleur: KLEUREN[3][1]
                                on_release: app.root.get_screen("admin_panel").tekst_opmaken(root, "kleur", self.kleur)
                            KleurKnop:
                                kleur: KLEUREN[4][1]
                                on_release: app.root.get_screen("admin_panel").tekst_opmaken(root, "kleur", self.kleur)
                            KleurKnop:
                                kleur: KLEUREN[5][1]
                                on_release: app.root.get_screen("admin_panel").tekst_opmaken(root, "kleur", self.kleur)
                            KleurKnop:
                                kleur: KLEUREN[6][1]
                                on_release: app.root.get_screen("admin_panel").tekst_opmaken(root, "kleur", self.kleur)

                        # 4. Alle opmaak eraf
                        ZachteKnop:
                            text: "Wis opmaak"
                            font_size: "12sp"
                            size_hint: None, None
                            size: "90dp", "34dp"
                            on_release: app.root.get_screen("admin_panel").tekst_opmaken(root, "wis")

                    # ---------- Nummer en titel naast elkaar ----------
                    BoxLayout:
                        size_hint_y: None
                        height: "56dp"
                        spacing: "10dp"

                        BoxLayout:
                            orientation: "vertical"
                            size_hint_x: None
                            width: "80dp"
                            spacing: "0dp"

                            VeldLabel:
                                text: "Nummer"

                            FormulierVeld:
                                id: nummer
                                multiline: False
                                input_filter: "int"   # alleen cijfers (plek op de objectenwand)

                        BoxLayout:
                            orientation: "vertical"
                            spacing: "0dp"

                            VeldLabel:
                                text: "Titel"

                            OpmaakVeld:
                                id: titel
                                multiline: False
                                height: "38dp"
                                # Klik in de titel: de opmaakknoppen werken nu op de titel
                                on_focus: if self.focus: root.opmaak_doel = "titel"

                    VeldLabel:
                        text: "Beschrijving"

                    OpmaakVeld:
                        id: beschrijving
                        hint_text: "Typ hier de beschrijving. Selecteer woorden of klik in een zin/alinea om op te maken."
                        # Klik in de beschrijving: de opmaakknoppen werken nu op de beschrijving
                        on_focus: if self.focus: root.opmaak_doel = "beschrijving"

                    VeldLabel:
                        text: "Het voorbeeld van de hele pagina (met afbeeldingen) staat onderaan."

                # Hoofdafbeelding: klein voorbeeld + knoppen op één regel
                Kaart:
                    BlokKop:
                        text: "Afbeelding"

                    BoxLayout:
                        size_hint_y: None
                        height: "48dp"
                        spacing: "8dp"

                        Image:
                            source: root.afbeelding
                            size_hint_x: None
                            width: "48dp"
                            fit_mode: "contain"
                            opacity: 1 if root.afbeelding else 0   # onzichtbaar als er geen afbeelding is
                            canvas.before:
                                Color:
                                    rgba: 228/255, 222/255, 210/255, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [6]

                        ZachteKnop:
                            text: "Kies afbeelding"
                            pos_hint: {"center_y": 0.5}
                            on_release: app.root.get_screen("admin_panel").kies_afbeelding(root)

                        ZachteKnop:
                            text: "Verwijder"
                            size_hint_x: None
                            width: "90dp"
                            pos_hint: {"center_y": 0.5}
                            on_release: root.afbeelding = ""

                    # Grootte van de hoofdfoto (het schilderij bovenaan de objectpagina)
                    BoxLayout:
                        size_hint_y: None
                        height: "38dp"
                        spacing: "8dp"

                        VeldLabel:
                            text: "Grootte op de objectpagina"
                            height: "38dp"

                        Spinner:
                            id: hoofd_formaat
                            text: "Normaal"   # standaard
                            values: ["Klein", "Normaal", "Groot", "Origineel"]
                            option_cls: "PositieOptie"
                            size_hint_x: None
                            width: "140dp"
                            font_name: "Tekst"
                            font_size: "14sp"
                            bold: True
                            color: 125/255, 67/255, 53/255, 1
                            background_normal: ""
                            background_down: ""
                            background_color: 0, 0, 0, 0
                            canvas.before:
                                Color:
                                    rgba: 232/255, 224/255, 212/255, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [8]

                    Label:
                        text: "Klein 25%  |  Normaal 35%  |  Groot 50% van de schermhoogte  |  Origineel = echte grootte"
                        font_name: "Klein"
                        font_size: "11sp"
                        color: 0.55, 0.55, 0.55, 1
                        size_hint_y: None
                        height: "16dp"
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                        shorten: True

                # Extra afbeeldingen: alleen de titels; klik op een titel om hem te bewerken
                Kaart:
                    BoxLayout:
                        size_hint_y: None
                        height: "30dp"
                        spacing: "8dp"

                        BlokKop:
                            text: "Extra afbeeldingen"
                            height: "30dp"

                        ZachteKnop:
                            text: "+ Toevoegen"
                            size_hint_x: None
                            width: "110dp"
                            height: "30dp"
                            on_release: app.root.get_screen("admin_panel").open_extra_formulier(root, -1)

                    BoxLayout:
                        id: extra_lijst
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: "5dp"
                        # De titel-knoppen worden in admin_panel.py aangemaakt (toon_extra_afbeeldingen)

                # Voorbeeld van de hele objectpagina: hoofdfoto, titel, beschrijving en extra foto's,
                # precies zoals op het scherm, maar verkleind. Verandert mee terwijl je het formulier invult.
                # (PaginaVoorbeeld staat in object_detail_screen.py)
                Kaart:
                    BlokKop:
                        text: "Voorbeeld van de objectpagina"

                    PaginaVoorbeeld:
                        titel: titel.voorbeeld
                        beschrijving: beschrijving.voorbeeld
                        afbeelding: root.afbeelding
                        hoofd_formaat: hoofd_formaat.text
                        extra: root.extra_afbeeldingen

        FoutLabel:
            id: foutmelding

        # Knoppen onderaan (altijd zichtbaar, scrollen niet mee)
        BoxLayout:
            size_hint_y: None
            height: "42dp"
            spacing: "10dp"

            ZachteKnop:
                text: "Annuleren"
                height: "42dp"
                font_size: "14sp"
                on_release: root.dismiss()

            HoofdKnop:
                text: "Opslaan"
                on_release: app.root.get_screen("admin_panel").formulier_opslaan(root)


# ============================================================
# BEVESTIGEN VERWIJDEREN (pop-up)
# ============================================================

<BevestigVerwijderen@Popup>:
    obj_id: 0
    object_naam: ""

    title: "Object verwijderen"
    title_font: "Titel"
    title_size: "20sp"
    title_color: 0.15, 0.15, 0.15, 1
    separator_color: 125/255, 67/255, 53/255, 1
    background: ""
    background_color: 244/255, 239/255, 230/255, 1
    size_hint: 0.5, None
    height: "200dp"
    auto_dismiss: False

    BoxLayout:
        orientation: "vertical"
        padding: "10dp"
        spacing: "12dp"

        Label:
            text: 'Weet je zeker dat je "' + root.object_naam + '" wilt verwijderen?'
            font_name: "Tekst"
            font_size: "15sp"
            color: 0.2, 0.2, 0.2, 1
            halign: "center"
            valign: "middle"
            text_size: self.size

        BoxLayout:
            size_hint_y: None
            height: "48dp"
            spacing: "12dp"

            Button:
                text: "Annuleren"
                font_name: "Tekst"
                font_size: "15sp"
                bold: True
                color: 125/255, 67/255, 53/255, 1
                background_normal: ""
                background_down: ""
                background_color: 0, 0, 0, 0
                on_release: root.dismiss()
                canvas.before:
                    Color:
                        rgba: (220/255, 210/255, 198/255, 1) if self.state == "down" else (232/255, 224/255, 212/255, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12]

            Button:
                text: "Verwijderen"
                font_name: "Tekst"
                font_size: "15sp"
                bold: True
                color: 1, 1, 1, 1
                background_normal: ""
                background_down: ""
                background_color: 0, 0, 0, 0
                on_release: app.root.get_screen("admin_panel").verwijderen_bevestigd(root)
                canvas.before:
                    Color:
                        rgba: (140/255, 35/255, 25/255, 1) if self.state == "down" else (180/255, 50/255, 40/255, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12]


# ============================================================
# ADMIN PANEL SCREEN
# ============================================================

<AdminPanelScreen>:

    canvas.before:
        Color:
            rgba: 244/255, 239/255, 230/255, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: ["20dp", "20dp", "20dp", "20dp"]
        spacing: "15dp"

        # ====================================================
        # BOVENSTE BALK
        # ====================================================

        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "55dp"
            spacing: "12dp"

            Button:
                text: "<"
                font_name: "Tekst"
                font_size: "22sp"
                bold: True
                color: 125/255, 67/255, 53/255, 1

                size_hint: None, None
                size: "40dp", "40dp"

                background_normal: ""
                background_down: ""
                background_color: 232/255, 224/255, 212/255, 1

                on_release:
                    root.terug_naar_home()

            BoxLayout:
                orientation: "vertical"

                Label:
                    text: "STADSMUSEUM VEENENDAAL"
                    font_name: "Tekst"
                    font_size: "11sp"
                    bold: True
                    color: 125/255, 67/255, 53/255, 1
                    halign: "left"
                    valign: "bottom"
                    text_size: self.size

                Label:
                    text: "Beheer objecten"
                    font_name: "Titel"
                    font_size: "22sp"
                    color: 0.15, 0.15, 0.15, 1
                    halign: "left"
                    valign: "top"
                    text_size: self.size


        # ====================================================
        # OBJECT TOEVOEGEN
        # ====================================================

        Button:
            text: "+  Object toevoegen"
            font_name: "Tekst"
            font_size: "16sp"
            bold: True
            color: 1, 1, 1, 1

            size_hint_y: None
            height: "55dp"

            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0

            on_release:
                root.object_toevoegen()

            canvas.before:
                Color:
                    rgba: (100/255, 50/255, 40/255, 1) if self.state == "down" else (125/255, 67/255, 53/255, 1)

                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(10)]


        # ====================================================
        # AANTAL OBJECTEN
        # ====================================================

        Label:
            id: aantal_label
            text: "0 OBJECTEN"
            font_name: "Klein"
            font_size: "12sp"
            bold: True
            color: 0.5, 0.5, 0.5, 1

            size_hint_y: None
            height: "20dp"

            halign: "left"
            valign: "middle"
            text_size: self.size


        # ====================================================
        # OBJECTEN LIJST
        # ====================================================

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True

            BoxLayout:
                id: objecten_lijst

                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "10dp"

                # De ObjectItems worden in admin_panel.py aangemaakt (laad_objecten)


        # ====================================================
        # WACHTWOORD WIJZIGEN EN UITLOGGEN
        # ====================================================

        AnchorLayout:
            size_hint_y: None
            height: "50dp"

            anchor_x: "center"
            anchor_y: "center"

            BoxLayout:
                size_hint: None, None
                width: self.minimum_width
                height: "44dp"
                spacing: "12dp"

                # Opent de pop-up om het wachtwoord van de adminpagina te veranderen
                Button:
                    text: "Wachtwoord wijzigen"
                    font_name: "Tekst"
                    font_size: "15sp"
                    bold: True
                    color: 125/255, 67/255, 53/255, 1

                    size_hint: None, None
                    size: "190dp", "44dp"

                    background_normal: ""
                    background_down: ""
                    background_color: 0, 0, 0, 0

                    on_release:
                        root.open_wachtwoord_formulier()

                    canvas.before:
                        Color:
                            rgba: (220/255, 210/255, 198/255, 1) if self.state == "down" else (232/255, 224/255, 212/255, 1)

                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(8)]

                Button:
                    text: "Uitloggen"
                    font_name: "Tekst"
                    font_size: "15sp"
                    bold: True
                    color: 125/255, 67/255, 53/255, 1

                    size_hint: None, None
                    size: "140dp", "44dp"

                    background_normal: ""
                    background_down: ""
                    background_color: 0, 0, 0, 0

                    on_release:
                        root.uitloggen()

                    canvas.before:
                        Color:
                            rgba: (220/255, 210/255, 198/255, 1) if self.state == "down" else (232/255, 224/255, 212/255, 1)

                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(8)]


# ============================================================
# WACHTWOORD WIJZIGEN (pop-up)
# ============================================================

<WachtwoordFormulier@Popup>:
    title: "Wachtwoord wijzigen"
    title_font: "Titel"
    title_size: "18sp"
    title_color: 0.15, 0.15, 0.15, 1
    separator_color: 125/255, 67/255, 53/255, 1
    background: ""
    background_color: 244/255, 239/255, 230/255, 1
    size_hint: None, None
    # Nooit groter dan het scherm
    width: min(Window.width * 0.9, dp(420))
    height: min(Window.height * 0.9, dp(390))
    auto_dismiss: False

    BoxLayout:
        orientation: "vertical"
        padding: "6dp"
        spacing: "8dp"

        Kaart:
            VeldLabel:
                text: "Huidig wachtwoord"
            FormulierVeld:
                id: huidig
                multiline: False
                password: True   # toont puntjes in plaats van letters
                write_tab: False  # Tab gaat naar het volgende veld

            VeldLabel:
                text: "Nieuw wachtwoord (minstens 8 tekens)"
            FormulierVeld:
                id: nieuw
                multiline: False
                password: True
                write_tab: False

            VeldLabel:
                text: "Herhaal nieuw wachtwoord"
            FormulierVeld:
                id: herhaal
                multiline: False
                password: True
                write_tab: False
                on_text_validate: app.root.get_screen("admin_panel").wachtwoord_opslaan(root)   # Enter = opslaan

        Widget:   # lege ruimte

        FoutLabel:
            id: foutmelding

        # Groene melding als het gelukt is
        Label:
            id: gelukt
            text: ""
            font_name: "Klein"
            font_size: "13sp"
            bold: True
            color: 0.18, 0.49, 0.20, 1
            size_hint_y: None
            height: "18dp" if self.text else 0

        BoxLayout:
            size_hint_y: None
            height: "42dp"
            spacing: "10dp"

            ZachteKnop:
                text: "Annuleren"
                height: "42dp"
                on_release: root.dismiss()

            HoofdKnop:
                text: "Opslaan"
                on_release: app.root.get_screen("admin_panel").wachtwoord_opslaan(root)

# ============================================================
# AFBEELDING KIEZEN (pop-up)
# ============================================================

<AfbeeldingKiezer@Popup>:
    formulier: None   # het formulier dat de afbeelding moet krijgen
    doel: "hoofd"     # "hoofd" = hoofdafbeelding, "extra" = extra afbeeldingen (meerdere tegelijk)

    title: "Kies een afbeelding"
    title_font: "Titel"
    title_size: "20sp"
    size_hint: 0.8, 0.8
    auto_dismiss: False

    BoxLayout:
        orientation: "vertical"
        spacing: "10dp"

        FileChooserIconView:
            id: kiezer
            filters: ["*.png", "*.jpg", "*.jpeg"]   # alleen afbeeldingen tonen

        BoxLayout:
            size_hint_y: None
            height: "48dp"
            spacing: "12dp"

            Button:
                text: "Annuleren"
                on_release: root.dismiss()

            Button:
                text: "Kiezen"
                on_release: app.root.get_screen("admin_panel").afbeelding_gekozen(root)
