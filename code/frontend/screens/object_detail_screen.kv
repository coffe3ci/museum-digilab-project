<ObjectDetailScreen>:
    FloatLayout:
        # 1. Achtergrond (Beige/Crème achtergrond)
        canvas.before:
            Color:
                rgba: 244/255, 239/255, 230/255, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # 2. Afbeelding over de hele bovenkant van de pagina (randen worden bijgesneden)
        Image:
            source: root.afbeelding
            fit_mode: "cover"
            opacity: 1 if root.afbeelding else 0
            size_hint: 1, 0.4
            pos_hint: {"x": 0, "top": 1}

        # 3. Tekst: onder de afbeelding, of bovenaan als er geen afbeelding is
        BoxLayout:
            orientation: "vertical"
            size_hint: 0.8, (0.54 if root.afbeelding else 0.82)
            pos_hint: {"center_x": 0.5, "top": 0.57 if root.afbeelding else 0.9}
            spacing: "15dp"

            # Titel
            Label:
                text: root.titel
                font_name: "assets/fonts/Chalet NewYorkNineteenEighty.otf"
                font_size: "30sp"
                bold: True
                color: 125/255, 67/255, 53/255, 1
                size_hint_y: None
                height: self.texture_size[1] + dp(10)
                halign: "center"
                text_size: self.width, None

            # Beschrijving (scrollbaar bij lange teksten)
            ScrollView:
                id: tekst_scroll
                do_scroll_x: False

                Label:
                    text: root.beschrijving
                    font_name: "assets/fonts/Chalet NewYorkNineteenEighty.otf"
                    font_size: "18sp"
                    line_height: 1.3   # iets meer ruimte tussen de regels
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_y: None
                    height: self.texture_size[1]
                    halign: "left"
                    valign: "top"
                    text_size: self.width, None

        # 4. Terug-knop (Ronde knop linksboven, ligt bovenop de afbeelding)
        Button:
            text: "<"
            font_size: "22sp"
            color: 0.2, 0.2, 0.2, 1
            size_hint: None, None
            size: "44dp", "44dp"
            pos_hint: {"x": 0.04, "top": 0.96}
            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            on_release: root.terug()
            canvas.before:
                Color:
                    rgba: (210/255, 200/255, 188/255, 1) if self.state == 'down' else (232/255, 224/255, 212/255, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [22]
