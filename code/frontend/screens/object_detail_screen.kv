#:import Window kivy.core.window.Window
# Maten van de lijst rond de hoofdfoto (in dp)
#:set PASSE_PARTOUT 18
#:set RAND 34

# Extra afbeelding onder de beschrijving: hele foto zichtbaar, in het midden,
# met afgeronde hoeken en een lichte schaduw.
# max_breedte / max_hoogte (in dp) komen uit het adminpaneel; 0 = geen limiet.
# origineel = True: de foto wordt op zijn echte grootte (in pixels) getoond.
<ExtraFoto@Image>:
    max_breedte: 0
    max_hoogte: 0
    origineel: False

    fit_mode: "contain"
    size_hint: None, None
    pos_hint: {"center_x": 0.5}
    # Breedte = de kleinste van: breedte van het tekstblok, max. breedte (of de echte breedte
    # bij "origineel"), en de breedte die bij de max. hoogte hoort.
    # Zo past de foto binnen alle limieten zonder uit te rekken, en nooit breder dan de tekst/kolom.
    width: min(self.parent.width if self.parent else 0, self.texture_size[0] if self.origineel else (dp(self.max_breedte) if self.max_breedte else float("inf")), dp(self.max_hoogte) * self.image_ratio if self.max_hoogte else float("inf"))
    height: self.width / self.image_ratio   # hoogte volgt de vorm van de foto

    canvas.before:
        # Lichte schaduw iets onder de foto
        Color:
            rgba: 0, 0, 0, 0.12
        RoundedRectangle:
            pos: self.x + dp(2), self.y - dp(3)
            size: self.size
            radius: [14]

        # Afgeronde hoeken via een sjabloon (stencil)
        StencilPush
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [14]
        StencilUse

    canvas.after:
        StencilUnUse
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [14]
        StencilPop


# Eén extra afbeelding met de titel eronder (als onderschrift)
<ExtraFotoBlok@BoxLayout>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    spacing: "6dp"

    ExtraFoto:
        id: foto

    Label:
        id: onderschrift
        font_name: "Klein"
        font_size: "14sp"
        color: 0.45, 0.45, 0.45, 1
        size_hint_y: None
        height: self.texture_size[1] if self.text else 0   # geen ruimte als er geen titel is
        halign: "center"
        text_size: self.width, None


# De hoofdfoto bovenaan de objectpagina, als een schilderij:
# donkere houten lijst met een gouden randje, een crème passe-partout en de hele foto erin.
# De foto wordt nooit bijgesneden. Hij is minstens 1/4 van het scherm hoog (meestal 35%),
# behalve bij hele brede foto's: die worden smaller gemaakt zodat ze op het scherm passen.
<Schilderij@AnchorLayout>:
    afbeelding: ""
    hoogte_deel: 0.35    # hoogte van de foto als deel van het scherm (0 = origineel: echte grootte)

    anchor_x: "center"
    anchor_y: "center"
    size_hint_y: None
    height: (foto.height + 2 * dp(RAND) + dp(10)) if self.afbeelding else 0   # + ruimte voor de schaduw
    opacity: 1 if self.afbeelding else 0

    Image:
        id: foto
        source: root.afbeelding
        fit_mode: "contain"
        size_hint: None, None
        # Gewenste hoogte: het gekozen deel van het scherm (klein/normaal/groot), of bij "origineel"
        # de echte breedte van de foto. Is de foto te breed, dan wordt hij zo breed als er plaats is
        # en de hoogte past zich aan (nooit bijgesneden).
        width: max(0, min(self.texture_size[0] if root.hoogte_deel == 0 else Window.height * root.hoogte_deel * self.image_ratio, root.width - 2 * dp(RAND)))
        height: self.width / self.image_ratio

        canvas.before:
            # Schaduw achter het schilderij
            Color:
                rgba: 0, 0, 0, 0.18
            Rectangle:
                pos: self.x - dp(RAND) + dp(5), self.y - dp(RAND) - dp(6)
                size: self.width + 2 * dp(RAND), self.height + 2 * dp(RAND)

            # Houten lijst (donkerbruin)
            Color:
                rgba: 92/255, 58/255, 36/255, 1
            Rectangle:
                pos: self.x - dp(RAND), self.y - dp(RAND)
                size: self.width + 2 * dp(RAND), self.height + 2 * dp(RAND)

            # Lichtere rand aan de buitenkant van de lijst (geeft diepte)
            Color:
                rgba: 140/255, 96/255, 60/255, 1
            Line:
                rectangle: (self.x - dp(RAND) + dp(2), self.y - dp(RAND) + dp(2), self.width + 2 * dp(RAND) - dp(4), self.height + 2 * dp(RAND) - dp(4))
                width: 1.2

            # Goud randje aan de binnenkant van de lijst
            Color:
                rgba: 196/255, 160/255, 92/255, 1
            Rectangle:
                pos: self.x - dp(PASSE_PARTOUT) - dp(3), self.y - dp(PASSE_PARTOUT) - dp(3)
                size: self.width + 2 * dp(PASSE_PARTOUT) + dp(6), self.height + 2 * dp(PASSE_PARTOUT) + dp(6)

            # Passe-partout (crème vlak rond de foto)
            Color:
                rgba: 250/255, 246/255, 238/255, 1
            Rectangle:
                pos: self.x - dp(PASSE_PARTOUT), self.y - dp(PASSE_PARTOUT)
                size: self.width + 2 * dp(PASSE_PARTOUT), self.height + 2 * dp(PASSE_PARTOUT)

            # Dun schaduwlijntje direct rond de foto
            Color:
                rgba: 0, 0, 0, 0.15
            Line:
                rectangle: (self.x - dp(1), self.y - dp(1), self.width + dp(2), self.height + dp(2))
                width: 1


<ObjectDetailScreen>:
    FloatLayout:
        # 1. Achtergrond (Beige/Crème achtergrond)
        canvas.before:
            Color:
                rgba: 244/255, 239/255, 230/255, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # 2. De hele pagina scrollt: schilderij, titel, beschrijving en extra foto's
        ScrollView:
            id: tekst_scroll
            do_scroll_x: False
            bar_width: "4dp"

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "20dp"
                # 10% ruimte links en rechts; bovenaan ruimte voor de terug-knop
                padding: [self.width * 0.1, dp(70), self.width * 0.1, dp(25)]

                # Hoofdfoto in een lijst (alleen als er een afbeelding is)
                Schilderij:
                    afbeelding: root.afbeelding
                    hoogte_deel: root.hoofd_hoogte_deel

                # Titel
                Label:
                    text: root.titel
                    font_name: "Titel"
                    font_size: "30sp"
                    color: 125/255, 67/255, 53/255, 1
                    size_hint_y: None
                    height: self.texture_size[1] + dp(10)
                    halign: "center"
                    text_size: self.width, None

                # Drie kolommen naast elkaar: links-foto's | beschrijving (+ midden-foto's) | rechts-foto's.
                # Een zijkolom zonder foto's is 0 breed, dan krijgt de beschrijving de hele breedte.
                BoxLayout:
                    id: rij
                    orientation: "horizontal"
                    size_hint_y: None
                    height: max(kolom_links.height, midden.height, kolom_rechts.height)

                    # Linkerkolom (ZijKolom staat in object_detail_screen.py)
                    ZijKolom:
                        id: kolom_links
                        size_hint: None, None
                        width: rij.width * 0.28 if self.children else 0
                        height: 0
                        pos_hint: {"top": 1}

                    # Middenkolom: beschrijving met daaronder de midden-foto's
                    BoxLayout:
                        id: midden
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
                        pos_hint: {"top": 1}
                        spacing: "25dp"
                        # Ruimte tussen de tekst en een zijkolom (alleen als die zijkolom foto's heeft)
                        padding: [dp(20) if kolom_links.children else 0, 0, dp(20) if kolom_rechts.children else 0, 0]

                        Label:
                            text: root.beschrijving
                            font_name: "Tekst"
                            font_size: "18sp"
                            line_height: 1.3   # iets meer ruimte tussen de regels
                            color: 0.2, 0.2, 0.2, 1
                            size_hint_y: None
                            height: self.texture_size[1]
                            halign: "left"
                            valign: "top"
                            text_size: self.width, None

                        # Midden-foto's onder elkaar (worden in object_detail_screen.py toegevoegd)
                        BoxLayout:
                            id: extra_fotos
                            orientation: "vertical"
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: "20dp"

                    # Rechterkolom
                    ZijKolom:
                        id: kolom_rechts
                        size_hint: None, None
                        width: rij.width * 0.28 if self.children else 0
                        height: 0
                        pos_hint: {"top": 1}

        # 3. Terug-knop (Ronde knop linksboven, blijft altijd staan)
        Button:
            text: "<"
            font_size: "22sp"
            color: 0.2, 0.2, 0.2, 1
            size_hint: None, None
            size: "44dp", "44dp"
            pos_hint: {"x": 0.04, "top": 0.96}
            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            on_release: root.terug()
            canvas.before:
                Color:
                    rgba: (210/255, 200/255, 188/255, 1) if self.state == 'down' else (232/255, 224/255, 212/255, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [22]
