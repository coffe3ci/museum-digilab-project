# ObjectKnop is een Python-klasse (zie object_screen.py); hier staat alleen hoe hij eruitziet.
<ObjectKnop>:
    canvas.before:
        # Witte afgeronde achtergrond (zichtbaar als er geen afbeelding is)
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12]

        # De afbeelding met afgeronde hoeken, via een "stencil" (sjabloon):
        # 1. teken de vorm (afgerond vlak) als sjabloon
        StencilPush
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12]
        StencilUse

        # 2. teken de afbeelding; alleen het deel binnen het sjabloon is zichtbaar.
        #    root.uitsnede is het bijgesneden deel van de afbeelding (zoals "cover").
        Color:
            rgba: (1, 1, 1, 1) if root.uitsnede else (1, 1, 1, 0)
        Rectangle:
            texture: root.uitsnede
            pos: self.pos
            size: self.size

        # 3. sjabloon weer opruimen
        StencilUnUse
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12]
        StencilPop

    # Knop wordt iets donkerder als je erop drukt (ook over de afbeelding heen)
    canvas.after:
        Color:
            rgba: (0, 0, 0, 0.15) if self.state == "down" else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12]

    # Titel: met afbeelding op een donkere balk onderaan, zonder afbeelding midden in de knop
    Label:
        text: root.titel
        font_name: "assets/fonts/Chalet NewYorkNineteenEighty.otf"
        font_size: "15sp"
        bold: True
        color: (1, 1, 1, 1) if root.afbeelding else (0.2, 0.2, 0.2, 1)
        size_hint_x: 1
        size_hint_y: None if root.afbeelding else 1
        height: "36dp"
        pos_hint: {"x": 0, "y": 0}
        halign: "center"
        valign: "middle"
        text_size: self.size

        canvas.before:
            Color:
                rgba: (0, 0, 0, 0.55) if root.afbeelding else (0, 0, 0, 0)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [0, 0, 12, 12]   # linksboven, rechtsboven, rechtsonder, linksonder


<ObjectScreen>:
    FloatLayout:
        # 1. Achtergrond (Beige/Crème achtergrond)
        canvas.before:
            Color:
                rgba: 244/255, 239/255, 230/255, 1
            Rectangle:
                pos: self.pos
                size: self.size
                # 2. Button Layout
        BoxLayout:
            orientation: "vertical"
            size_hint: 0.8, 0.75
            pos_hint: {"center_x": 0.5, "y": 0.05}
            spacing: "20dp"

            GridLayout:
                id: grid
                cols: 3
                spacing: "15dp"

            BoxLayout:
                id: pagina_knoppen
                size_hint_y: None
                height: "30dp"
                spacing: "15dp"



        # 3. Admin-icoon (rechtsboven)
        Button:
            size_hint: None, None
            size: "55dp", "55dp"
            pos_hint: {"right": 0.97, "top": 0.97}
            background_normal: "assets/objects_img/logo/management.png"
            background_down: "assets/objects_img/logo/management.png"
            background_color: 1, 1, 1, 1
            border: 0, 0, 0, 0
            on_release: root.go_to_admin()
        
        # 4. Terug-knop (Ronde knop linksboven)
        Button:
            text: "<"
            font_size: "22sp"
            color: 0.2, 0.2, 0.2, 1
            size_hint: None, None
            size: "44dp", "44dp"
            pos_hint: {"x": 0.04, "top": 0.96}
            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            on_release: root.terug_naar_home()
            canvas.before:
                Color:
                    rgba: (210/255, 200/255, 188/255, 1) if self.state == 'down' else (232/255, 224/255, 212/255, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [22]