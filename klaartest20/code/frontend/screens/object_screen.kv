#:import TITEL_MARGE frontend.screens.object_screen.TITEL_MARGE
# ObjectKnop is een Python-klasse (zie object_screen.py); hier staat alleen hoe hij eruitziet.
<ObjectKnop>:
    canvas.before:
        # Witte afgeronde achtergrond (zichtbaar als er geen afbeelding is)
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12]

        # De afbeelding zelf, direct getekend als afgeronde rechthoek met de foto erin.
        # (Vroeger met een "stencil"-sjabloon; dat is op de tablet-GPU veel trager.)
        # root.uitsnede is het bijgesneden deel van de afbeelding (zoals "cover").
        Color:
            rgba: (1, 1, 1, 1) if root.uitsnede else (1, 1, 1, 0)
        RoundedRectangle:
            texture: root.uitsnede
            pos: self.pos
            size: self.size
            radius: [12]

    # Knop wordt iets donkerder als je erop drukt (ook over de afbeelding heen)
    canvas.after:
        Color:
            rgba: (0, 0, 0, 0.15) if self.state == "down" else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12]

    # Titel: met afbeelding op een donkere balk onderaan, zonder afbeelding midden in de knop.
    # Lange titels: de balk wordt hoger (max. 2 regels) en de letter iets kleiner, zodat de
    # titel er altijd netjes in past (zie past_titel in object_screen.py).
    Label:
        text: root.titel_tekst
        font_name: "Tekst"
        font_size: root.titel_grootte
        bold: True
        color: (1, 1, 1, 1) if root.afbeelding else (0.2, 0.2, 0.2, 1)
        size_hint_x: 1
        size_hint_y: None if root.afbeelding else 1
        height: self.texture_size[1] + dp(14)
        pos_hint: {"x": 0, "y": 0}
        halign: "center"
        valign: "middle"
        text_size: self.width - dp(2 * TITEL_MARGE), None   # ruimte aan de zijkanten
        line_height: 0.95

        canvas.before:
            Color:
                rgba: (0, 0, 0, 0.55) if root.afbeelding else (0, 0, 0, 0)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [0, 0, 12, 12]   # linksboven, rechtsboven, rechtsonder, linksonder

    # Volgnummer linksboven in een rond donker rondje
    Label:
        text: root.nummer
        # Standaard lettertype (Roboto): dat centreert cijfers netjes in het rondje
        font_size: "14sp"
        bold: True
        color: 1, 1, 1, 1
        size_hint: None, None
        size: "30dp", "30dp"
        pos_hint: {"x": 0.03, "top": 0.97}
        halign: "center"
        valign: "middle"
        text_size: self.size

        canvas.before:
            Color:
                rgba: 0, 0, 0, 0.55
            RoundedRectangle:
                # Rondje iets naar links t.o.v. de tekst, zodat het nummer optisch in het midden staat
                pos: self.x - dp(1), self.y
                size: self.size
                radius: [15]


# Pijlknop < of > naast de objectenwand: rond, zelfde kleuren als de terug-knop.
# Vaag en niet klikbaar als je niet verder kunt (eerste/laatste 9).
<PijlKnop@Button>:
    font_size: "24sp"
    color: 0.2, 0.2, 0.2, 1
    disabled_color: 0.2, 0.2, 0.2, 1
    size_hint: None, None
    size: "52dp", "52dp"
    background_normal: ""
    background_down: ""
    background_disabled_normal: ""
    background_disabled_down: ""
    background_color: 0, 0, 0, 0
    # (Hoe doorzichtig de pijl is, regelt object_screen.py: werk_navigatie_bij)
    canvas.before:
        Color:
            rgba: (210/255, 200/255, 188/255, 1) if self.state == "down" else (232/255, 224/255, 212/255, 1)
        Ellipse:
            pos: self.pos
            size: self.size


# Ronde paginanummer-knop onder de objectenwand.
# actief = True: dit zijn de 9 objecten die je nu ziet (bruin met witte tekst).
<PaginaKnop@Button>:
    actief: False
    font_name: "Tekst"
    font_size: "15sp"
    bold: True
    color: (1, 1, 1, 1) if self.actief else (125/255, 67/255, 53/255, 1)
    size_hint: None, None
    size: "36dp", "36dp"
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    canvas.before:
        # Dunne lichte ring om de actieve knop
        Color:
            rgba: (125/255, 67/255, 53/255, 0.25) if self.actief else (0, 0, 0, 0)
        Ellipse:
            pos: self.x - dp(4), self.y - dp(4)
            size: self.width + dp(8), self.height + dp(8)
        # Het rondje zelf
        Color:
            rgba: ((100/255, 50/255, 40/255, 1) if self.state == "down" else (125/255, 67/255, 53/255, 1)) if self.actief else ((215/255, 204/255, 190/255, 1) if self.state == "down" else (232/255, 224/255, 212/255, 1))
        Ellipse:
            pos: self.pos
            size: self.size


# "..." tussen de paginanummers als er heel veel pagina's zijn
<PaginaPuntjes@Label>:
    text: "..."
    font_name: "Tekst"
    font_size: "15sp"
    bold: True
    color: 125/255, 67/255, 53/255, 1
    size_hint: None, None
    size: "24dp", "36dp"


# Filterknop boven de objectenwand: één periode van de tijdlijn (of "Alle objecten").
# actief = True: dit filter is gekozen (bruin met witte tekst).
# De tekst bevat markup: naam vetgedrukt met de periode kleiner eronder (twee regels).
# Alle filterknoppen zijn even breed: een derde van de filterbalk (er staan er altijd 3 in beeld).
<FilterKnop@Button>:
    actief: False
    markup: True
    font_name: "Tekst"
    font_size: "15sp"
    halign: "center"
    valign: "middle"
    text_size: self.width - dp(20), None   # te lange naam gaat netjes naar een volgende regel
    line_height: 0.95
    color: (1, 1, 1, 1) if self.actief else (125/255, 67/255, 53/255, 1)
    size_hint: 1, 1
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    canvas.before:
        Color:
            rgba: ((100/255, 50/255, 40/255, 1) if self.state == "down" else (125/255, 67/255, 53/255, 1)) if self.actief else ((215/255, 204/255, 190/255, 1) if self.state == "down" else (232/255, 224/255, 212/255, 1))
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]


# Bubbel om 9 objecten van dezelfde categorie (als "groeperen" aan staat in het adminpaneel):
# een zacht gekleurd vlak met afgeronde hoeken en bovenaan de naam en periode.
# Het raster met objectknoppen wordt in object_screen.py in "inhoud" gezet.
<CategorieBubbel@BoxLayout>:
    naam: ""
    periode: ""
    kleur: (0.93, 0.86, 0.76, 1)
    orientation: "vertical"
    padding: ["12dp", "6dp", "12dp", "12dp"]
    spacing: "6dp"
    canvas.before:
        Color:
            rgba: self.kleur
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18)]

    # Naam van de periode, met de jaartallen erachter
    Label:
        markup: True
        text: "[b]" + root.naam + "[/b]" + (("   [size=13sp]" + root.periode + "[/size]") if root.periode else "")
        font_name: "Tekst"
        font_size: "16sp"
        color: 125/255, 67/255, 53/255, 1
        size_hint_y: None
        height: "26dp"
        halign: "left"
        valign: "middle"
        text_size: self.size
        shorten: True

    BoxLayout:
        id: inhoud


<ObjectScreen>:
    FloatLayout:
        # 1. Achtergrond (Beige/Crème achtergrond)
        canvas.before:
            Color:
                rgba: 244/255, 239/255, 230/255, 1
            Rectangle:
                pos: self.pos
                size: self.size
        # 2. Logo van het bedrijf, midden boven de objecten (zelfde logo als op de homepagina)
        Image:
            source: "assets/images/logo.png"
            fit_mode: "contain"   # logo houdt zijn vorm
            # Zelfde vlak als eerst (40% breed, 13% hoog), maar 19dp kleiner
            size_hint: None, None
            size: self.parent.width * 0.4 - dp(19), self.parent.height * 0.13 - dp(19)
            pos_hint: {"center_x": 0.5, "top": 0.96}

        # 3. De objectenwand: je ziet steeds 9 objecten (3x3).
        #    Eén keer vegen naar links/rechts schuift (met animatie) naar de volgende/vorige 9.
        #    Het vegen zelf staat in object_screen.py (class VeegWand).
        #    (Onder ruimte voor de paginanummers, boven ruimte voor de filterknoppen.)
        VeegWand:
            id: veegwand
            # Filterbalk uit (instelling in het adminpaneel)? Dan wordt de wand hoger
            size_hint: 0.8, (0.63 if root.filter_zichtbaar else 0.69)
            pos_hint: {"center_x": 0.5, "y": 0.11}
            # Pijlen en nummers bijwerken als je naar andere 9 gaat (ook bij vegen)
            on_blok: root.werk_navigatie_bij()
            on_aantal_blokken: root.werk_navigatie_bij()

            # Blokken van 3x3 naast elkaar (worden in object_screen.py aangemaakt).
            # Schuift naar links mee met de "positie" van de VeegWand.
            BoxLayout:
                id: wand
                orientation: "horizontal"
                size_hint: None, None
                width: self.minimum_width
                height: self.parent.height
                x: self.parent.x - self.parent.positie
                y: self.parent.y
                spacing: "15dp"

        # Melding als er in het gekozen filter geen objecten zitten
        Label:
            id: leeg_melding
            text: "Er zijn (nog) geen objecten in deze periode."
            font_name: "Tekst"
            font_size: "18sp"
            color: 125/255, 67/255, 53/255, 1
            opacity: 0
            size_hint: 0.8, None
            height: "40dp"
            pos_hint: {"center_x": 0.5, "center_y": 0.11 + (0.63 if root.filter_zichtbaar else 0.69) / 2}
            halign: "center"
            text_size: self.size

        # Filterknoppen (tijdlijn): "Alle objecten" + één knop per periode.
        # Er staan altijd precies 3 filters in beeld. Net als bij de objecten:
        # vegen of de pijltjes gebruiken om de volgende/vorige 3 te zien (met animatie).
        # De knoppen worden in object_screen.py aangemaakt (maak_filterknoppen).
        VeegWand:
            id: filter_wand
            size_hint: 0.8, None
            height: "50dp"
            pos_hint: {"center_x": 0.5, "center_y": 0.79}
            on_blok: root.werk_filterpijlen_bij()
            on_aantal_blokken: root.werk_filterpijlen_bij()

            # Blokken van 3 filters naast elkaar; schuift mee met de "positie" van de VeegWand
            BoxLayout:
                id: filters
                orientation: "horizontal"
                size_hint: None, None
                width: self.minimum_width
                height: self.parent.height
                x: self.parent.x - self.parent.positie
                y: self.parent.y
                spacing: "10dp"

        # Pijltjes naast de filters (kleiner dan die naast de objecten)
        PijlKnop:
            id: filter_links
            text: "<"
            font_size: "18sp"
            size: "38dp", "38dp"
            pos_hint: {"center_x": 0.05, "center_y": 0.79}
            on_release: filter_wand.ga_naar_blok(filter_wand.blok - 1)

        PijlKnop:
            id: filter_rechts
            text: ">"
            font_size: "18sp"
            size: "38dp", "38dp"
            pos_hint: {"center_x": 0.95, "center_y": 0.79}
            on_release: filter_wand.ga_naar_blok(filter_wand.blok + 1)

        # Pijl links: naar de vorige 9 objecten
        PijlKnop:
            id: pijl_links
            text: "<"
            pos_hint: {"center_x": 0.05, "center_y": 0.11 + (0.63 if root.filter_zichtbaar else 0.69) / 2}
            on_release: veegwand.ga_naar_blok(veegwand.blok - 1)

        # Pijl rechts: naar de volgende 9 objecten
        PijlKnop:
            id: pijl_rechts
            text: ">"
            pos_hint: {"center_x": 0.95, "center_y": 0.11 + (0.63 if root.filter_zichtbaar else 0.69) / 2}
            on_release: veegwand.ga_naar_blok(veegwand.blok + 1)

        # Paginanummers onderin (1 2 3 4 ...): worden in object_screen.py aangemaakt,
        # zoveel als er pagina's van 9 objecten zijn
        BoxLayout:
            id: pagina_nummers
            size_hint: None, None
            width: self.minimum_width
            height: "44dp"
            spacing: "10dp"
            pos_hint: {"center_x": 0.5, "center_y": 0.055}

        # Gekozen periode onderin links: blijft altijd zichtbaar, ook als de filterbalk
        # naar andere periodes geveegd is (tekst komt uit object_screen.py: werk_gekozen_filter_bij).
        # Loopt door tot vlak voor de paginanummers in het midden (nooit eroverheen).
        Label:
            id: gekozen_filter
            markup: True
            font_name: "Tekst"
            font_size: "15sp"
            color: 125/255, 67/255, 53/255, 1
            opacity: 1 if root.filter_zichtbaar else 0
            size_hint: None, None
            width: max(0, (pagina_nummers.x if pagina_nummers.children else root.width * 0.9) - self.x - dp(16))
            height: "44dp"
            pos_hint: {"x": 0.1, "center_y": 0.055}
            halign: "left"
            valign: "middle"
            text_size: self.size
            shorten: True
            shorten_from: "right"

        # 4. Onzichtbare admin-knop (rechtsboven in de hoek): 4x snel tikken opent het inlogscherm
        Button:
            size_hint: None, None
            size: "100dp", "100dp"
            pos_hint: {"right": 1, "top": 1}
            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            on_release: root.admin_tik()
        
        # 5. Terug-knop (Ronde knop linksboven)
        Button:
            text: "<"
            font_size: "22sp"
            color: 0.2, 0.2, 0.2, 1
            size_hint: None, None
            size: "44dp", "44dp"
            pos_hint: {"x": 0.04, "top": 0.96}
            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            on_release: root.terug_naar_home()
            canvas.before:
                Color:
                    rgba: (210/255, 200/255, 188/255, 1) if self.state == 'down' else (232/255, 224/255, 212/255, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [22]